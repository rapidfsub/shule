<Layouts.app flash={@flash}>
  <.header>
    {@page_title}
    <:actions>
      <.link navigate={~p"/problems/new"}>
        <.button>새 문제 등록</.button>
      </.link>
    </:actions>
  </.header>

  <Cinder.Table.table 
    resource={Plato.Problem}
    theme="daisy_ui"
    id="problems-table"
    row_click={fn problem -> JS.navigate(~p"/problems/#{problem.id}") end}
  >
    <:col :let={problem} field="content" filter label="문제 내용">
      <div class="max-w-md">
        <p class="truncate">{problem.content}</p>
      </div>
    </:col>
    <:col :let={problem} field="subject" filter={[type: :select, options: [{"수학", :math}, {"영어", :english}], prompt: "전체 과목"]} sort label="과목">
      <span class={[
        "inline-flex px-2 py-1 text-xs font-semibold rounded-full",
        if(problem.subject == :math,
          do: "bg-blue-100 text-blue-800",
          else: "bg-green-100 text-green-800"
        )
      ]}>
        {if problem.subject == :math, do: "수학", else: "영어"}
      </span>
    </:col>
    <:col :let={problem} field="difficulty" filter={[type: :select, options: [{"하", :low}, {"중", :medium}, {"상", :high}], prompt: "전체 난이도"]} sort label="난이도">
      <span class={[
        "inline-flex px-2 py-1 text-xs font-semibold rounded-full",
        case problem.difficulty do
          :low -> "bg-green-100 text-green-800"
          :medium -> "bg-yellow-100 text-yellow-800"
          :high -> "bg-red-100 text-red-800"
        end
      ]}>
        {case problem.difficulty do
          :low -> "하"
          :medium -> "중"
          :high -> "상"
        end}
      </span>
    </:col>
    <:col :let={problem} field="correct_answer" label="정답">
      {String.upcase(Atom.to_string(problem.correct_answer))}
    </:col>
    <:col :let={problem} field="inserted_at" sort label="등록일">
      {Calendar.strftime(problem.inserted_at, "%Y-%m-%d")}
    </:col>
    <:col :let={problem} label="관리">
      <div class="flex space-x-2">
        <.link navigate={~p"/problems/#{problem}/edit"} class="text-blue-600 hover:text-blue-900">
          수정
        </.link>
        <.link
          phx-click={JS.push("delete", value: %{id: problem.id})}
          data-confirm="정말 삭제하시겠습니까?"
          class="text-red-600 hover:text-red-900"
        >
          삭제
        </.link>
      </div>
    </:col>
  </Cinder.Table.table>
</Layouts.app>
