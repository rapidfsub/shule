```elixir
defmodule FileKit do
  def krx_data_path() do
    Path.join([__DIR__, "..", "priv", "krx_data"]) |> Path.expand()
  end

  def summaries_file_path() do
    Path.join([krx_data_path(), "summaries", "20250808.csv"])
  end

  def candles_path() do
    krx_data_path() |> Path.join("candles")
  end

  def candles_path(isin, year) do
    Path.join([krx_data_path(), "candles", isin, "#{year}.parquet"])
  end
end
```

```elixir
summaries_df = FileKit.summaries_file_path() |> DataFrame.from_csv!()
