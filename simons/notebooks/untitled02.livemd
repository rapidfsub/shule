use Simons.KrxData.Prelude
```

```elixir
defmodule SimKit do
  require Explorer.Series

  def list_trading_days(year) do
    DataFrameKit.list_trading_days(year) |> Series.to_list()
  end

  def list_trading_days_before(date, n) do
    date.year..1990//-1
    |> Enum.reduce_while(nil, fn year, acc ->
      days = DataFrameKit.list_trading_days(year)

      days =
        if acc do
          Series.concat(days, acc)
        else
          days
        end
        |> Series.filter(less(_, ^date))
        |> Series.sort()
        |> Series.tail(n)

      if Series.count(days) < n do
        {:cont, days}
      else
        {:halt, days}
      end
    end)
    |> Series.to_list()
  end

  def list_trading_days(s_date, e_date) do
    Enum.flat_map(s_date.year..e_date.year//1, fn year ->
      year
      |> DataFrameKit.list_trading_days()
      |> Series.filter(greater_equal(_, ^s_date) and less_equal(_, ^e_date))
      |> Series.sort()
      |> Series.to_list()
    end)
  end
end
