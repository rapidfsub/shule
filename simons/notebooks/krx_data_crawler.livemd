alias Explorer.DataFrame
alias Explorer.Series
require Explorer.DataFrame
```

```elixir
defmodule FileKit do
  @date ~D[2025-08-08]
  def krx_data_path() do
    Path.join([__DIR__, "..", "priv", "krx_data"]) |> Path.expand()
  end

  def summaries_path() do
    krx_data_path() |> Path.join("summaries")
  end

  def summaries_file_path() do
    summaries_path() |> Path.join("20250808.csv")
  end

  def profiles_path() do
    krx_data_path() |> Path.join("profiles")
  end

  def default_filename(ext) do
    Calendar.strftime(@date, "%Y%m%d") <> ext
  end

  def profile_file_path(isin) do
    path = profiles_path() |> Path.join(isin)
    File.mkdir_p!(path)
    Path.join(path, default_filename(".csv"))
  end

  def profiles_file_path() do
    profiles_path() |> Path.join(default_filename(".parquet"))
  end

  def candles_path() do
    krx_data_path() |> Path.join("candles")
  end

  def candles_file_path(isin, year) do
    path = candles_path() |> Path.join(isin)
    File.mkdir_p!(path)
    Path.join(path, "#{year}.csv")
  end

  def setup() do
    krx_data_path() |> File.mkdir_p!()
    summaries_path() |> File.mkdir_p!()
    profiles_path() |> File.mkdir_p!()
    candles_path() |> File.mkdir_p!()
  end
end
```

```elixir
FileKit.setup()
```

```elixir
summaries_df = FileKit.summaries_file_path() |> DataFrame.from_csv!()
```

