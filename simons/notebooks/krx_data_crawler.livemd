```elixir
defmodule CrawlerKit do
  def crawl_profiles(df) do
    df[:isin]
    |> Series.to_enum()
    |> Enum.chunk_every(5)
    |> Enum.chunk_every(100)
    |> Enum.each(fn iss ->
      for is <- iss do
        for isin <- is do
          filename = FileKit.profile_file_path(isin)

          if File.exists?(filename) do
            {:error, :already_exists}
          else
            KrxDataKit.get_profile(isin)
            |> Map.fetch!(:body)
            |> List.wrap()
            |> DataFrame.new()
            |> DataFrame.to_csv!(filename)
          end
        end
        |> IO.inspect(label: Enum.join(is, ", "))
        |> Enum.any?(&(&1 == :ok))
        |> if do
          :timer.seconds(1) |> Process.sleep()
        else
          {:error, :no_sleep}
        end
      end
      |> Enum.any?(&(&1 == :ok))
      |> if do
        :timer.minutes(1) |> Process.sleep()
      else
        {:error, :no_sleep}
      end
    end)
  end

  def merge_profiles() do
    path = FileKit.profiles_file_path()

    if not File.exists?(path) do
      for dir <- FileKit.profiles_path() |> File.ls!(),
          path = FileKit.profiles_path() |> Path.join(dir),
          File.dir?(path),
          filename <- File.ls!(path) do
        df = Path.join(path, filename) |> DataFrame.from_csv!()

        df
        |> DataFrame.mutate(
          PARVAL: cast(^df[:PARVAL], :string) |> cast(:u64),
          CORP_TEL_NO: cast(^df[:CORP_TEL_NO], :string),
          ISU_SRT_CD: cast(^df[:ISU_SRT_CD], :string)
        )
      end
      |> DataFrame.concat_rows()
      |> DataFrame.to_parquet!(path)
    end

    DataFrame.from_parquet!(path)
  end

  def crawl_candles(df, s_date, e_date) do
    df[:isin]
    |> Series.to_enum()
    |> Enum.chunk_every(5)
    |> Enum.chunk_every(100)
    |> Enum.each(fn iss ->
      for is <- iss do
        for isin <- is do
          Task.async(fn ->
            filename = FileKit.candles_file_path(isin, s_date.year)

            if File.exists?(filename) do
              {:error, :already_exists}
            else
              KrxDataKit.get_candles(isin, s_date, e_date)
              |> Map.fetch!(:body)
              |> Map.fetch!("output")
              |> DataFrame.new()
              |> DataFrame.to_csv!(filename)
            end
          end)
        end
        |> Task.await_many()
        |> IO.inspect(label: Enum.join(is, ", "))
        |> Enum.any?(&(&1 == :ok))
        |> if do
          :timer.seconds(1) |> Process.sleep()
        else
          {:error, :no_sleep}
        end
      end
      |> Enum.any?(&(&1 == :ok))
      |> if do
        for _ <- 1..6 do
          :timer.seconds(10) |> Process.sleep()
          IO.puts("sleep 10 secs")
        end
      else
        {:error, :no_sleep}
      end
    end)
  end
end
```

```elixir
CrawlerKit.merge_profiles()
```

```elixir
CrawlerKit.crawl_candles(summaries_df, ~D[2023-01-01], ~D[2024-12-31])
```
